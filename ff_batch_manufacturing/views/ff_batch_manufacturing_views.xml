<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_batch_manufacturing_view_tree" model="ir.ui.view">
        <field name="name">ff.batch.manufacturing.list</field>
        <field name="model">ff.batch.manufacturing</field>
        <field name="arch" type="xml">
            <list string="Batch Manufacturing" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="manufacturing_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="user_id"/>
                <field name="line_count"/>
                <field name="total_estimated_cost" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="ff_batch_manufacturing_view_form" model="ir.ui.view">
        <field name="name">ff.batch.manufacturing.form</field>
        <field name="model">ff.batch.manufacturing</field>
        <field name="arch" type="xml">
            <form string="Batch Manufacturing">
                <header>
                    <button name="action_confirm_manufacture" type="object" string="Confirm &amp; Manufacture"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            class="btn-secondary" groups="mrp.group_mrp_manager" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_manufacturing_orders" icon="fa-industry">
                            <field name="line_count" widget="statinfo" string="Manufacturing Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="manufacturing_date" readonly="state != 'draft'"/>
                            <field name="picking_type_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="location_src_id" readonly="state != 'draft'"/>
                            <field name="location_dest_id" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Manufacturing Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-success="manufacturing_state == 'done'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="uom_id"/>
                                    <field name="location_src_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="source_location_override" string="Custom Source"/>
                                    <field name="dest_location_override" string="Custom Destination"/>
                                    <field name="components_availability_state" widget="badge"
                                           decoration-success="components_availability_state == 'available'"
                                           decoration-danger="components_availability_state == 'unavailable'"
                                           decoration-warning="components_availability_state in ('expected', 'late')"/>
                                    <field name="components_availability"/>
                                    <field name="estimated_cost" widget="monetary"/>
                                    <field name="actual_cost" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <button name="action_view_components" type="object" string="View Components" icon="fa-list"/>
                                    <field name="production_id" string="Manufacturing Order"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary">
                            <group>
                                <field name="total_planned_qty"/>
                                <field name="total_estimated_cost" widget="monetary"/>
                                <field name="total_actual_cost" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Add notes for this batch..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_batch_manufacturing_action" model="ir.actions.act_window">
        <field name="name">Batch Manufacturing</field>
        <field name="res_model">ff.batch.manufacturing</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first batch manufacturing sheet</p>
            <p>Group several independent manufacturing orders into one controlled batch.</p>
        </field>
    </record>

    <menuitem id="ff_batch_manufacturing_menu" name="Batch Manufacturing"
              parent="mrp.menu_mrp_manufacturing" action="ff_batch_manufacturing_action" sequence="35"/>
</odoo>
