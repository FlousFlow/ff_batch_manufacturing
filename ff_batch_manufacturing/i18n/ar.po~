msgid "The selected location belongs to another company."
msgstr "الموقع المحدد تابع لشركة أخرى."

#. module: ff_batch_manufacturing
msgid "Manufacturing order %s has work orders. Complete it through the native Work Orders flow."
msgstr "أمر التصنيع %s يحتوي على أوامر عمل. أكمله من خلال مسار أوامر العمل الأصلي."

#. module: ff_batch_manufacturing
msgid "Manufacturing order %s requires an additional native Odoo step before it can be completed."
msgstr "أمر التصنيع %s يحتاج إلى خطوة إضافية أصلية في أودو قبل إتمامه."

#. module: ff_batch_manufacturing
msgid "Manufacturing order %s was not completed."
msgstr "لم يكتمل أمر التصنيع %s."

#. module: ff_batch_manufacturing
msgid "Batch %s cannot be reset because a linked Manufacturing Order is completed. Reverse the native stock operation first."
msgstr "لا يمكن إعادة الدفعة %s إلى المسودة لأن أمر تصنيع مرتبطًا بها مكتمل. اعكس عملية المخزون الأصلية أولًا."

#. module: ff_batch_manufacturing
msgid "Batch %s contains a cancelled Manufacturing Order and cannot be reset automatically."
msgstr "تحتوي الدفعة %s على أمر تصنيع ملغى ولا يمكن إعادتها إلى المسودة تلقائيًا."

